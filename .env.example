# Copy this file to .env and fill in real values.
# .env is git-ignored - it never gets committed.
# This file (.env.example) IS committed, with placeholders only.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Used by both Django (settings.py) and docker-compose.yml (Postgres container).
# For local `python manage.py runserver` with SQLite, just leave DB_HOST unset/blank.
# For `docker compose up`, all four are required - docker-complyose reads this
# same file to configure the Postgres container's credentials.
#testing localy
DB_HOST=localhost
DB_NAME=clinic_booking
DB_USER=postgres
DB_PASSWORD=
DB_PORT=5432

#testing on render
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.<your-project-ref>
DB_PASSWORD=<your supabase db password>
DB_NAME=postgres